# syntax=docker/dockerfile:1

# Production image: compiled JavaScript, production dependencies only.
# Development keeps using ./Dockerfile (tsx in watch mode).

FROM node:24-slim AS build
WORKDIR /app

COPY package.json ./
RUN npm install

COPY tsconfig.json ./
COPY src ./src
RUN npm run build


FROM node:24-slim
ENV NODE_ENV=production
WORKDIR /app

COPY package.json ./
RUN npm install --omit=dev && npm cache clean --force

COPY --from=build /app/dist ./dist

USER node
EXPOSE 3000
CMD ["node", "dist/server.js"]
