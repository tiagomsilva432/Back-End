{
  // Só para o editor e o `npm run test:types`: o Jest (SWC) não verifica tipos.
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "rootDir": ".",
    "noEmit": true,
    "declaration": false,
    "declarationMap": false,
    "sourceMap": false
  },
  "include": ["src", "tests"],
  "exclude": ["node_modules", "dist"]
}
