#Ambiente
NODE_ENV=development
FE_URL=http://localhost:5173
#URL
BASE_URL=http://localhost
PORT=3000

# CORS — origens do frontend, separadas por vírgulas e sem barra no fim.
# Vazio em desenvolvimento permite qualquer origem; em produção bloqueia tudo.
CORS_ORIGINS=http://localhost:5173

# Base de dados (PostgreSQL)
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=root
DB_NAME=erp_ossilvas_dev
DB_LOGGING=false

# Auth
JWT_SECRET=troca-isto-por-um-segredo-aleatorio
JWT_EXPIRES_IN=1d
BCRYPT_ROUNDS=12
SIGNUP_TOKEN_EXPIRATION_DAYS=7

# Email (SMTP)
# Sem SMTP_HOST os emails são escritos na consola em vez de enviados.
#
# Gmail: ativa a verificação em 2 passos e gera uma App Password
#   SMTP_HOST=smtp.gmail.com / SMTP_PORT=587 / SMTP_USER=<o-teu>@gmail.com
#   SMTP_PASSWORD=<app password de 16 letras> / MAIL_FROM=<o-teu>@gmail.com
# Brevo: verifica um remetente em Senders & IPs
#   SMTP_HOST=smtp-relay.brevo.com / SMTP_PORT=587 / SMTP_USER=<login brevo>
#   SMTP_PASSWORD=<smtp key> / MAIL_FROM=<endereço verificado>
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM=nao-responder@localhost

# Só a true se o email de CADA empresa estiver verificado no fornecedor.
# A false a empresa aparece no nome do remetente e no Reply-To.
MAIL_ALLOW_COMPANY_FROM=false
