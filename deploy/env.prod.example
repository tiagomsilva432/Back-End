# Copia para ../.env.prod (ao lado do compose.prod.yaml) e preenche.
# O .env.prod nunca vai para o git.

# Endereço público, com o protocolo. Com sslip.io: o IP do servidor com hífens.
#   PUBLIC_URL=https://203-0-113-10.sslip.io
# Para testar localmente: PUBLIC_URL=http://localhost
PUBLIC_URL=

# Base de dados. Gera a password com: openssl rand -base64 24
DB_USER=erp
DB_PASSWORD=
DB_NAME=erp

# Gera com: openssl rand -base64 48
JWT_SECRET=
JWT_EXPIRES_IN=1d
BCRYPT_ROUNDS=12
SIGNUP_TOKEN_EXPIRATION_DAYS=7
PASSWORD_RESET_EXPIRATION_HOURS=1

# Email (Brevo). Sem SMTP_HOST, os emails só aparecem nos logs da api.
SMTP_HOST=smtp-relay.brevo.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM=
MAIL_ALLOW_COMPANY_FROM=false

# Onde está o repositório do frontend, relativo a este diretório.
# FRONTEND_DIR=../Front-End
